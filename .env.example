# Django
DEBUG=True
SECRET_KEY=change-me-in-production
# Hostnames only — no scheme, no port.
ALLOWED_HOSTS=umrahcompany.co.uk,www.umrahcompany.co.uk,153.92.210.143,localhost,127.0.0.1,testserver
# In Docker point this at the mounted volume: sqlite:///data/db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3
# Full scheme+host, comma separated, no trailing slash. Django rejects every
# form POST from an origin that is not listed here once DEBUG is off.
CSRF_TRUSTED_ORIGINS=https://umrahcompany.co.uk,https://www.umrahcompany.co.uk,http://153.92.210.143,https://153.92.210.143
# Set true when nginx terminates TLS in front of gunicorn
USE_X_FORWARDED_PROTO=False
TIME_ZONE=Asia/Kolkata

# Docker deployment — nginx server_name and Let's Encrypt registration.
# DOMAIN is the bare apex; the www. host is added automatically.
DOMAIN=umrahcompany.co.uk
CERTBOT_EMAIL=
# Set true to hit Let's Encrypt's staging CA while testing (avoids rate limits)
CERTBOT_STAGING=false
# Set true for one boot to load demo websites, inventory, leads and bookings
SEED_DEMO=false

# Razorpay — leave blank to run payments in simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BOOKING_TAX_PERCENT=5

# AI chat engine — without a key the rule-based engine handles conversations
# Usually set from the dashboard (AI Settings) instead; these are the fallback.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_ENABLED=true
AI_MAX_HISTORY=20
AI_TIMEOUT_SECONDS=30
