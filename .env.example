# AI chat engine — without a key the rule-based engine handles conversations
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_ENABLED=true
AI_MAX_HISTORY=20
AI_TIMEOUT_SECONDS=30
